<% winner_nom = sc.winner&.nominee %>
<% is_announced = sc.winner.present? %>
<% winner_nominee_id = sc.winner&.nominee_id %>
<% pick_types = season.scoring_scheme.pick_types.order(:display_order) %>

<% selections_by_nominee = sc.pick_selections.each_with_object(Hash.new { |h, k| h[k] = [] }) do |selection, hash|
  hash[selection.nominee_id] << selection
end %>

<div id="season_category_<%= sc.id %>_winner"
     class="card p-0 overflow-hidden <%= is_announced ? 'border-l-[3px] border-l-oscar-gold' : '' %>">

  <div class="flex gap-3 p-4">
    <% if is_announced %>
      <div class="flex-shrink-0 rounded-lg overflow-hidden shadow-sm self-start" style="width:64px;height:96px;">
        <% if winner_nom&.poster_url.present? %>
          <img src="<%= winner_nom.poster_url %>"
               alt="<%= winner_nom.movie_name %>"
               class="w-full h-full object-cover">
        <% else %>
          <div class="w-full h-full bg-oscar-gold/10 flex items-center justify-center">
            <svg class="w-6 h-6 text-oscar-gold" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2L9 9H2l6 4.5L5.5 21 12 16.5 18.5 21 16 13.5 22 9h-7z"/>
            </svg>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="flex-1 min-w-0">
      <div class="flex items-start justify-between gap-2 mb-1">
        <h3 class="text-base font-bold text-oscar-text leading-tight"><%= sc.category_name %></h3>
        <% if is_announced %>
          <div class="flex items-center gap-1.5 flex-shrink-0">
            <span class="text-[10px] font-semibold uppercase tracking-wider text-oscar-gold bg-oscar-gold/10 px-2 py-0.5 rounded">Announced</span>
            <% if is_admin %>
              <%= button_to "✕", admin_season_winner_path(season, sc.winner),
                    method: :delete,
                    form: { data: { turbo_confirm: "Remove this winner?" } },
                    class: "text-[10px] font-semibold text-oscar-muted hover:text-red-500 bg-transparent border-0 px-1 py-0.5 cursor-pointer transition-colors leading-none" %>
            <% end %>
          </div>
        <% else %>
          <span class="text-[10px] font-semibold uppercase tracking-wider text-oscar-muted bg-oscar-surface px-2 py-0.5 rounded flex-shrink-0">Pending</span>
        <% end %>
      </div>

      <% if is_announced && winner_nom %>
        <div class="flex items-center gap-1.5 mt-1.5">
          <svg class="w-3.5 h-3.5 text-oscar-gold flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2L9 9H2l6 4.5L5.5 21 12 16.5 18.5 21 16 13.5 22 9h-7z"/>
          </svg>
          <span class="text-sm font-bold text-oscar-gold leading-tight"><%= winner_nom.display_name %></span>
        </div>
      <% end %>

      <% if !is_announced && is_admin %>
        <%= form_with url: admin_season_winners_path(season), class: "mt-3" do |f| %>
          <input type="hidden" name="winner[season_category_id]" value="<%= sc.id %>">
          <div class="flex gap-2 items-center">
            <select name="winner[nominee_id]" class="select-field text-xs py-1.5" required>
              <option value="">— Announce winner —</option>
              <% sc.nominees.each do |nom| %>
                <option value="<%= nom.id %>"><%= nom.display_name %></option>
              <% end %>
            </select>
            <%= f.submit "★ Announce", class: "btn btn-gold btn-sm flex-shrink-0" %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <% has_any_picks = selections_by_nominee.any? %>
  <% if has_any_picks %>
    <div class="border-t border-oscar-border/50 px-4 pt-3 pb-4 space-y-1 text-sm">
      <% sc.nominees.each do |nom| %>
        <% selections = selections_by_nominee[nom.id] %>
        <% next if selections.blank? %>

        <% is_winner = is_announced && winner_nominee_id == nom.id %>

        <div class="py-1.5 px-3 rounded-md <%= is_winner ? 'bg-oscar-gold/10' : '' %>">
          <div class="flex items-center gap-2 mb-1">
            <% if is_winner %>
              <svg class="w-3.5 h-3.5 text-oscar-gold flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2L9 9H2l6 4.5L5.5 21 12 16.5 18.5 21 16 13.5 22 9h-7z"/>
              </svg>
            <% else %>
              <span class="w-3.5 h-3.5 flex-shrink-0"></span>
            <% end %>
            <% if nom.poster_url.present? %>
              <button type="button"
                      data-action="click->movie-poster#show"
                      data-poster-url="<%= nom.poster_url %>"
                      data-movie-title="<%= nom.movie_name %>"
                      class="text-left text-xs hover:underline underline-offset-2 cursor-pointer bg-transparent border-0 p-0 font-semibold
                             <%= is_winner ? 'text-oscar-gold' : is_announced ? 'text-oscar-muted' : 'text-oscar-text hover:text-oscar-gold' %> transition-colors">
                <%= nom.display_name %>
              </button>
            <% else %>
              <span class="text-xs font-semibold <%= is_winner ? 'text-oscar-gold' : is_announced ? 'text-oscar-muted' : 'text-oscar-text' %>">
                <%= nom.display_name %>
              </span>
            <% end %>
          </div>

          <div class="ml-5 space-y-0.5">
            <% pick_types.each do |pick_type| %>
              <% type_selections = selections.select { |s| s.pick_type_id == pick_type.id } %>
              <% next if type_selections.empty? %>

              <% chip_points = type_selections.first.score_for(winner_nominee_id) if is_announced && winner_nominee_id %>
              <% chip_label_points = chip_points&.zero? ? nil : chip_points %>
              <div class="flex flex-wrap items-center gap-1">
                <% if is_announced %>
                  <span class="text-[10px] font-bold tracking-wide px-1.5 py-0.5 rounded leading-none flex-shrink-0 <%= points_color_class(chip_points || 0) %> bg-oscar-surface"
                        title="<%= pick_type.name %>">
                    <%= pick_chip_label(pick_type, chip_label_points) %>
                  </span>
                  <% type_selections.map { |s| s.player.user.display_name }.sort.each do |name| %>
                    <span class="text-[11px] px-1.5 py-0.5 rounded leading-none font-medium <%= if chip_points&.positive?
                      'text-emerald-700 bg-emerald-50'
                    elsif chip_points&.negative?
                      'text-red-700 bg-red-50'
                    else
                      'text-gray-400 bg-gray-50 line-through'
                    end %>">
                      <%= name %>
                    </span>
                  <% end %>
                <% else %>
                  <span class="text-[10px] font-bold tracking-wide text-white px-1.5 py-0.5 rounded leading-none flex-shrink-0"
                        style="background-color: <%= pick_type.color %>"
                        title="<%= pick_type.name %>"><%= pick_type.emoji %></span>
                  <% type_selections.map { |s| s.player.user.display_name }.sort.each do |name| %>
                    <span class="text-[11px] text-oscar-text bg-oscar-surface px-1.5 py-0.5 rounded leading-none"><%= name %></span>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
