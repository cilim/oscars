<% content_for(:title, "History - Oscars Pool") %>

<div class="mb-10">
  <h1 class="text-3xl font-bold text-oscar-gold">History</h1>
  <p class="text-oscar-muted mt-1">
    <% years = @nights.map { |night| night[:year] } %>
    <% if years.empty? %>
      Hogged nights, Picture splits, and films that left with nothing — once the envelopes open.
    <% else %>
      <%= years.min %>–<%= years.max %>: hogged nights, Picture splits, and films that left with nothing.
    <% end %>
  </p>
</div>

<% if @nights.empty? %>
  <div class="card text-center py-16">
    <p class="text-oscar-muted text-lg">No winners yet. Come back after the envelopes.</p>
  </div>
<% else %>
  <div class="space-y-8">
    <section class="card history-panel">
      <h2 class="text-xl font-bold text-oscar-text mb-4">Who hogged the night?</h2>
      <%= render "history/chart", options: @hog_chart %>
    </section>

    <section class="card history-panel">
      <h2 class="text-xl font-bold text-oscar-text mb-4">Glory and heartbreak</h2>
      <% if @heartbreak_decades.any? %>
        <%= tag.div class: "history-chart",
          data: {
            controller: "heartbreak-chart",
            heartbreak_chart_panels_value: heartbreak_panels_json(@heartbreak_decades)
          } do %>
          <div class="flex flex-wrap items-center gap-3 mb-4">
            <label for="heartbreak-decade" class="text-sm font-medium text-oscar-text">Ceremony decade</label>
            <select id="heartbreak-decade"
              class="rounded-lg border border-oscar-border bg-oscar-surface px-3 py-2 text-sm text-oscar-text focus:outline-none focus:ring-2 focus:ring-oscar-gold/40"
              data-heartbreak-chart-target="select"
              data-action="heartbreak-chart#change">
              <% @heartbreak_decades.each do |panel| %>
                <option value="<%= panel[:label] %>" <%= "selected" if panel[:label] == OscarHistoryCharts::HEARTBREAK_ALL_LABEL %>>
                  <%= panel[:label] %>
                </option>
              <% end %>
            </select>
          </div>
          <%= tag.div class: "history-chart__plot", data: { heartbreak_chart_target: "container" } %>
        <% end %>
      <% end %>
      <p class="text-oscar-muted text-xs mt-3">Gold won at least one Oscar; red won none. Axes match across decades.</p>
    </section>

    <section class="card history-panel">
      <h2 class="text-xl font-bold text-oscar-text mb-4">Did Picture take the board?</h2>
      <%= render "history/chart", options: @picture_chart %>
    </section>
  </div>
<% end %>
