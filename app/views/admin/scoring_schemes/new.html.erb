<div class="mb-8">
  <h1 class="text-3xl font-bold text-oscar-gold">New Scoring Scheme</h1>
  <p class="text-oscar-muted mt-1">Add pick types after creating the scheme.</p>
</div>

<%= form_with model: [:admin, @scoring_scheme], class: "space-y-5" do |f| %>
  <% if @scoring_scheme.errors.any? %>
    <div class="flash-alert">
      <ul class="list-disc list-inside space-y-1">
        <% @scoring_scheme.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "label-text" %>
    <%= f.text_field :name, class: "input-field", placeholder: "e.g. Classic, Chaos Mode" %>
  </div>

  <div class="flex gap-3">
    <%= f.submit "Create Scheme", class: "btn btn-gold" %>
    <%= link_to "Cancel", admin_scoring_schemes_path, class: "btn btn-outline no-underline" %>
  </div>
<% end %>
