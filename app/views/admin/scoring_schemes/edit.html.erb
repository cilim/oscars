<div class="mb-8">
  <h1 class="text-3xl font-bold text-oscar-gold"><%= @scoring_scheme.name %></h1>
  <p class="text-oscar-muted mt-1">
    <%= @scoring_scheme.pick_types.size %> pick types
    <% if @scoring_scheme.locked? %>
      &middot; <span class="text-amber-700 font-semibold">Locked — picks already reference this scheme</span>
    <% end %>
  </p>
</div>

<% if @scoring_scheme.locked? %>
  <div class="flash-alert mb-6">
  Player picks already reference this scheme. Editing is disabled to keep historical scores consistent.
  </div>
<% end %>

<%= form_with model: [:admin, @scoring_scheme], class: "space-y-6",
              data: { controller: "nested-pick-types pick-type-fields" } do |f| %>
  <% if @scoring_scheme.errors.any? %>
    <div class="flash-alert">
      <ul class="list-disc list-inside space-y-1">
        <% @scoring_scheme.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card space-y-4">
    <div>
      <%= f.label :name, class: "label-text" %>
      <%= f.text_field :name, class: "input-field", disabled: @scoring_scheme.locked? %>
    </div>
  </div>

  <div class="card">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-bold text-oscar-text">Pick Types</h2>
      <% unless @scoring_scheme.locked? %>
        <button type="button" class="btn btn-outline btn-sm" data-action="nested-pick-types#add">
          Add Pick Type
        </button>
      <% end %>
    </div>

    <% unless @scoring_scheme.assignable? %>
      <p class="text-sm text-amber-700 mb-4">Add at least one pick type before this scheme can be assigned to a season.</p>
    <% end %>

    <div class="space-y-4" data-nested-pick-types-target="container">
      <%= f.fields_for :pick_types do |pick_type_fields| %>
        <%= render "pick_type_fields", f: pick_type_fields, locked: @scoring_scheme.locked? %>
      <% end %>
    </div>

    <template data-nested-pick-types-target="template">
      <%= f.fields_for :pick_types, PickType.new(color: "#0ea5e9", display_order: 1), child_index: "NEW_RECORD" do |pick_type_fields| %>
        <%= render "pick_type_fields", f: pick_type_fields, locked: false %>
      <% end %>
    </template>
  </div>

  <% unless @scoring_scheme.locked? %>
    <div class="flex gap-3">
      <%= f.submit "Save Scheme", class: "btn btn-gold" %>
      <%= link_to "Cancel", admin_scoring_schemes_path, class: "btn btn-outline no-underline" %>
    </div>
  <% else %>
    <%= link_to "Back", admin_scoring_schemes_path, class: "btn btn-outline no-underline" %>
  <% end %>
<% end %>
