<div class="relative rounded-xl border-2 bg-white shadow-sm <%= locked ? "p-3" : "p-3 pt-8 pb-8" %> transition-colors"
     style="border-color: <%= f.object.color.presence || "#E5E3DD" %>"
     data-nested-pick-types-target="item"
     data-controller="pick-type-fields color-picker"
     data-action="dragstart->pick-types-sortable#dragStart dragover->pick-types-sortable#dragOver drop->pick-types-sortable#drop dragend->pick-types-sortable#dragEnd">
  <%= f.hidden_field :_destroy, value: "0", data: { nested_pick_types_target: "destroyField" } %>
  <%= f.hidden_field :display_order, data: { pick_types_sortable_target: "orderInput" } %>
  <%= f.color_field :color, class: "sr-only", disabled: locked,
                     data: { color_picker_target: "input", action: "input->color-picker#applyColor" } %>

  <% unless locked %>
    <span class="absolute top-2 left-2 cursor-grab active:cursor-grabbing text-oscar-muted/50 hover:text-oscar-muted select-none"
          title="Drag to reorder" data-action="mousedown->pick-types-sortable#armDrag">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
        <circle cx="4" cy="3" r="1.3"/><circle cx="4" cy="8" r="1.3"/><circle cx="4" cy="13" r="1.3"/>
        <circle cx="10" cy="3" r="1.3"/><circle cx="10" cy="8" r="1.3"/><circle cx="10" cy="13" r="1.3"/>
      </svg>
    </span>

    <button type="button" class="absolute top-2 right-2 text-oscar-muted/50 hover:text-red-600 leading-none text-lg"
            title="Remove" data-action="nested-pick-types#remove">&times;</button>

    <button type="button" class="absolute bottom-2 right-2 text-base leading-none hover:scale-110 transition-transform"
            title="Change color" data-action="color-picker#open">🎨</button>
  <% end %>

  <div class="space-y-2">
    <%= f.text_field :name, disabled: locked, placeholder: "Pick type name",
                      class: "w-full border-0 border-b border-oscar-border bg-transparent px-0 py-1 text-center text-sm font-semibold text-oscar-text placeholder:font-normal placeholder:text-oscar-muted/70 focus:border-oscar-gold focus:outline-none focus:ring-0" %>

    <div class="flex items-center justify-center gap-2 py-1">
      <div class="flex flex-col items-center gap-0.5">
        <%= f.number_field :points_on_correct, disabled: locked, step: 1,
                            class: "input-field w-14 px-1 py-1 text-center text-sm" %>
        <span class="text-[9px] font-semibold uppercase tracking-wide text-oscar-muted">Correct</span>
      </div>
      <div class="flex flex-col items-center gap-0.5">
        <%= f.number_field :points_on_incorrect, disabled: locked, step: 1,
                            class: "input-field w-14 px-1 py-1 text-center text-sm" %>
        <span class="text-[9px] font-semibold uppercase tracking-wide text-oscar-muted">Incorrect</span>
      </div>
    </div>

    <div class="relative flex justify-center" data-controller="emoji-picker">
      <%= f.text_field :emoji, class: "hidden", disabled: locked, maxlength: 4,
                        data: { emoji_picker_target: "input" } %>

      <% if locked %>
        <div class="flex h-12 w-12 items-center justify-center rounded-full border border-oscar-border bg-oscar-surface text-2xl">
          <%= f.object.emoji %>
        </div>
      <% else %>
        <button type="button" title="Pick emoji" data-action="emoji-picker#toggle" data-emoji-picker-target="display"
                class="flex h-12 w-12 items-center justify-center rounded-full border border-oscar-border bg-oscar-surface text-2xl transition-colors hover:border-oscar-gold hover:bg-white">
          <%= f.object.emoji.presence || "❔" %>
        </button>
      <% end %>

      <div class="absolute left-1/2 top-full z-20 mt-2 hidden -translate-x-1/2 overflow-hidden rounded-lg shadow-lg" data-emoji-picker-target="popover">
        <emoji-picker data-action="emoji-click->emoji-picker#select"></emoji-picker>
      </div>
    </div>
  </div>

  <div class="mt-2 flex flex-wrap items-center justify-center gap-2 border-t border-oscar-border/70 pt-2">
    <label class="flex cursor-pointer items-center gap-1.5">
      <%= f.check_box :allow_multiple_selections, class: "h-3.5 w-3.5 accent-oscar-gold", disabled: locked,
                      data: { pick_type_fields_target: "multiToggle", action: "pick-type-fields#toggleMulti" } %>
      <span class="text-[11px] text-oscar-muted">Multi-select</span>
    </label>

    <div data-pick-type-fields-target="maxSelections" class="<%= f.object.allow_multiple_selections? ? "" : "hidden" %>">
      <%= f.number_field :max_selections, class: "input-field w-14 py-1 text-center text-xs", placeholder: "Max",
                         disabled: locked || !f.object.allow_multiple_selections?, min: 2, value: f.object.max_selections %>
    </div>
  </div>
</div>
