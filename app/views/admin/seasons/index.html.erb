<div class="flex items-center justify-between mb-8">
  <h1 class="text-3xl font-bold text-oscar-gold">Seasons</h1>
  <div class="flex gap-2">
    <%= link_to "Scrape Nominations", new_admin_scrape_path, class: "btn btn-outline no-underline" %>
    <%= link_to "Database backup", admin_database_backup_path, class: "btn btn-outline no-underline" %>
    <%= link_to "New Season", new_admin_season_path, class: "btn btn-gold no-underline" %>
  </div>
</div>

<% if @seasons.any? %>
  <div class="space-y-4">
    <% @seasons.each do |season| %>
      <%= link_to admin_season_path(season), class: "card flex items-center justify-between group hover:border-oscar-gold/50 hover:bg-white transition-all duration-300 no-underline" do %>
        <div>
          <h2 class="text-lg font-bold text-oscar-text group-hover:text-oscar-gold transition-colors"><%= season.name %></h2>
          <p class="text-oscar-muted text-sm">
            <%= season.season_categories.count %> categories &middot;
            <%= season.players.count %> players
            <% if season.locked? %>
              &middot; <span class="text-oscar-red">Locked</span>
            <% end %>
            <% if season.archived? %>
              &middot; <span class="text-oscar-muted">Archived</span>
            <% end %>
          </p>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="card text-center py-12">
    <p class="text-oscar-muted text-lg">No seasons yet. Create your first one!</p>
  </div>
<% end %>
