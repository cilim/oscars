<%= form_with model: [:admin, season], class: "space-y-5" do |f| %>
  <% if season.errors.any? %>
    <div class="flash-alert">
      <ul class="list-disc list-inside space-y-1">
        <% season.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "label-text" %>
    <%= f.text_field :name, class: "input-field", placeholder: "e.g. 2026 Oscars" %>
  </div>

  <div>
    <%= f.label :year, class: "label-text" %>
    <%= f.number_field :year, class: "input-field", placeholder: "e.g. 2026" %>
  </div>

  <div>
    <%= f.label :scoring_scheme_id, "Scoring scheme", class: "label-text" %>
    <% scheme_locked = season.persisted? && season.scoring_scheme_locked? %>
    <% if scheme_locked %>
      <p class="text-sm text-oscar-text font-medium"><%= season.scoring_scheme.name %></p>
      <p class="text-xs text-oscar-muted mt-1">Cannot change — players have already submitted picks.</p>
    <% else %>
      <%= f.collection_select :scoring_scheme_id,
            @assignable_scoring_schemes || ScoringScheme.includes(:pick_types).select(&:assignable?).sort_by(&:name),
            :id, :name,
            { prompt: "Select a scheme" },
            class: "select-field" %>
      <% if (@assignable_scoring_schemes || []).empty? %>
        <p class="text-xs text-amber-700 mt-1">No schemes with pick types are available. Create one first.</p>
      <% end %>
    <% end %>
  </div>

  <div class="flex gap-6">
    <label class="flex items-center gap-2 cursor-pointer">
      <%= f.check_box :locked, class: "w-4 h-4 accent-oscar-gold" %>
      <span class="text-sm text-oscar-text">Lock picks</span>
    </label>

    <label class="flex items-center gap-2 cursor-pointer">
      <%= f.check_box :archived, class: "w-4 h-4 accent-oscar-gold" %>
      <span class="text-sm text-oscar-text">Archived</span>
    </label>
  </div>

  <div class="flex gap-3">
    <%= f.submit class: "btn btn-gold" %>
    <%= link_to "Cancel", admin_seasons_path, class: "btn btn-outline no-underline" %>
  </div>
<% end %>
