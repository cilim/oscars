<% name_editing = season.errors[:name].any? %>
<% year_editing = season.errors[:year].any? %>
<% pick_count = PickSelection.joins(:player).where(players: { season: season }).count %>
<% confirm_msg = if pick_count > 0
     "WARNING: #{pick_count} player pick#{"s" if pick_count != 1} will be permanently deleted along with all categories, nominees, and players. This cannot be undone. Proceed?"
   else
     "Delete this season and all its categories, nominees, and players? This cannot be undone."
   end %>

<div id="season-header" class="flex items-start justify-between gap-4 mb-8">
  <div class="min-w-0 flex-1 space-y-3">
    <% if season.errors.any? %>
      <div class="flash-alert">
        <ul class="list-disc list-inside space-y-1">
          <% season.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div data-controller="inline-edit">
      <div data-inline-edit-target="display" class="flex items-center gap-2 min-w-0" <%= "hidden" if name_editing %>>
        <h1 class="text-3xl font-bold text-oscar-gold truncate"><%= season.name %></h1>
        <%= render "pencil_button", label: "Edit name" %>
      </div>
      <div data-inline-edit-target="editor" <%= "hidden" unless name_editing %>>
        <%= form_with model: [:admin, season], class: "flex items-center gap-2" do |f| %>
          <%= f.text_field :name,
                class: "input-field flex-1 text-2xl font-bold",
                data: { inline_edit_target: "input" } %>
          <%= f.submit "Save", class: "btn btn-gold" %>
        <% end %>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <div data-controller="inline-edit" class="flex items-center gap-1">
        <div data-inline-edit-target="display" class="flex items-center gap-1" <%= "hidden" if year_editing %>>
          <span class="text-oscar-muted"><%= season.year %></span>
          <%= render "pencil_button", label: "Edit year" %>
        </div>
        <div data-inline-edit-target="editor" class="flex items-center gap-2" <%= "hidden" unless year_editing %>>
          <%= form_with model: [:admin, season], class: "flex items-center gap-2" do |f| %>
            <%= f.number_field :year,
                  class: "input-field w-28",
                  data: { inline_edit_target: "input" } %>
            <%= f.submit "Save", class: "btn btn-gold" %>
          <% end %>
        </div>
      </div>

      <span class="text-oscar-border">·</span>

      <div data-controller="inline-edit" class="flex items-center gap-1 min-w-0">
        <% scheme_locked = season.scoring_scheme_locked? %>
        <% if scheme_locked %>
          <div>
            <span class="text-oscar-text font-medium"><%= season.scoring_scheme.name %></span>
            <p class="text-xs text-oscar-muted">Cannot change — players have already submitted picks.</p>
          </div>
        <% else %>
          <div data-inline-edit-target="display" class="flex items-center gap-1">
            <span class="text-oscar-text"><%= season.scoring_scheme.name %></span>
            <%= render "pencil_button", label: "Edit scoring scheme" %>
          </div>
          <div data-inline-edit-target="editor" class="flex items-center gap-2" hidden>
            <%= form_with model: [:admin, season], class: "flex items-center gap-2" do |f| %>
              <%= f.collection_select :scoring_scheme_id,
                    @assignable_scoring_schemes || [],
                    :id, :name,
                    {},
                    { class: "select-field", data: { inline_edit_target: "input" } } %>
              <%= f.submit "Save", class: "btn btn-gold" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <%= form_with model: [:admin, season],
          class: "flex flex-wrap gap-6",
          data: { controller: "autosubmit", turbo_stream: true } do |f| %>
      <label class="flex items-center gap-2 cursor-pointer">
        <%= f.check_box :locked, class: "w-4 h-4 accent-oscar-gold", data: { action: "change->autosubmit#submit" } %>
        <span class="text-sm text-oscar-text">Lock picks</span>
      </label>
      <label class="flex items-center gap-2 cursor-pointer">
        <%= f.check_box :archived, class: "w-4 h-4 accent-oscar-gold", data: { action: "change->autosubmit#submit" } %>
        <span class="text-sm text-oscar-text">Archived</span>
      </label>
    <% end %>

    <p class="text-oscar-muted">
      Manage categories, nominees, and players
      <% if season.locked? %>
        &middot; <span class="text-oscar-red">Picks Locked</span>
      <% end %>
      <% if season.archived? %>
        &middot; Archived
      <% end %>
    </p>
  </div>

  <%= button_to admin_season_path(season),
        method: :delete,
        class: "btn btn-danger p-2.5",
        form: { data: { turbo_confirm: confirm_msg } },
        aria: { label: "Delete season" } do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0 1 16.138 21H7.862a2 2 0 0 1-1.995-1.858L5 7m5 4v6m4-6v6M9 7V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3m-9 0h10" />
    </svg>
  <% end %>
</div>
