<% content_for(:title, "Make Picks - #{@season.name}") %>

<div class="mb-8">
  <div class="flex items-center justify-between flex-wrap gap-4">
    <div>
      <h1 class="text-3xl font-bold text-oscar-gold">Make Your Picks</h1>
      <p class="text-oscar-muted mt-1"><%= @season.name %> &middot; Picks save automatically</p>
    </div>
    <%= link_to "Back to Season", season_path(@season), class: "btn btn-outline no-underline" %>
  </div>
</div>

<% pick_types_json = @pick_types.map { |pt|
  {
    id: pt.id,
    emoji: pt.emoji,
    name: pt.name,
    color: pt.color,
    multi: pt.allow_multiple_selections?,
    max: pt.allow_multiple_selections? ? pt.max_selections : 1,
    pointsCorrect: pt.points_on_correct,
    pointsIncorrect: pt.points_on_incorrect,
    risky: pt.risky?
  }
}.to_json %>

<div class="mb-6"
     data-controller="picks-progress"
     data-picks-progress-total-value="<%= @season_categories.size %>"
     data-action="picks-carousel:changed@window->picks-progress#update">
  <div class="relative h-9 rounded-full overflow-hidden bg-oscar-surface border border-oscar-border">
    <div class="absolute inset-y-0 left-0 bg-oscar-gold flex items-center px-4 transition-all duration-500"
         style="width: 0%" hidden
         data-picks-progress-target="fill">
      <span class="text-xs font-bold text-white whitespace-nowrap overflow-hidden"
            data-picks-progress-target="pickedLabel" hidden></span>
    </div>
    <div class="absolute inset-y-0 right-0 flex items-center px-4">
      <span class="text-xs font-semibold text-oscar-muted whitespace-nowrap"
            data-picks-progress-target="remainingLabel" hidden></span>
    </div>
  </div>
</div>

<%= form_with url: season_picks_path(@season), method: :patch, class: "space-y-6",
              data: { controller: "picks-form",
                      "picks-form-season-id-value": @season.id,
                      action: "submit->picks-form#clearStorage" } do |f| %>

  <% @season_categories.each do |sc| %>
    <% category_selections = @selections_by_category[sc.id] || {} %>

    <div class="card"
         data-controller="picks-carousel"
         data-picks-carousel-season-id-value="<%= @season.id %>"
         data-picks-carousel-category-id-value="<%= sc.id %>"
         data-picks-carousel-pick-types-value="<%= pick_types_json %>">

      <% @pick_types.each do |pick_type| %>
        <% selected_ids = category_selections[pick_type.id] || [] %>
        <div data-picks-carousel-target="pickTypeGroup" data-pick-type-id="<%= pick_type.id %>">
          <% selected_ids.each do |nominee_id| %>
            <input type="hidden"
                   name="picks[<%= sc.id %>][<%= pick_type.id %>][nominee_ids][]"
                   value="<%= nominee_id %>"
                   data-picks-carousel-target="pickInput"
                   data-pick-type-id="<%= pick_type.id %>">
          <% end %>
        </div>
      <% end %>

      <div class="flex items-start justify-between gap-4 mb-4">
        <div>
          <h3 class="text-xl font-bold text-oscar-text"><%= sc.category_name %></h3>
          <p class="text-oscar-muted text-xs mt-0.5"><%= sc.has_person ? "Person & film" : "Film" %></p>
        </div>

        <div class="text-right text-xs shrink-0 space-y-1">
          <% @pick_types.each do |pick_type| %>
            <div class="flex items-center gap-1.5 justify-end">
              <span class="font-black text-[10px] text-white px-1.5 py-0.5 rounded leading-none"
                    style="background-color: <%= pick_type.color %>"
                    title="<%= pick_type.name %>"><%= pick_type.emoji %></span>
              <span data-picks-carousel-target="summary"
                    data-pick-type-id="<%= pick_type.id %>"
                    class="text-oscar-muted">—</span>
            </div>
          <% end %>
        </div>
      </div>

      <div class="flex flex-wrap gap-x-4 gap-y-1 text-[11px] text-oscar-muted mb-3">
        <% @pick_types.each do |pick_type| %>
          <span class="<%= pick_type.risky? ? 'text-amber-700 font-semibold' : '' %>">
            <%= pick_type_legend_label(pick_type) %>
            <% if pick_type.allow_multiple_selections? %>
              <span data-pick-counter data-pick-type-id="<%= pick_type.id %>" class="ml-1 font-semibold"></span>
            <% end %>
          </span>
        <% end %>
      </div>

      <div class="relative -mx-2 px-2">
        <button type="button"
                data-action="click->picks-carousel#prev"
                class="absolute left-0 top-[72px] -translate-y-1/2 z-10 w-7 h-7 flex items-center justify-center rounded-full bg-white border border-oscar-border shadow text-oscar-muted hover:text-oscar-text hover:shadow-md transition-all text-lg leading-none select-none">
          &#8249;
        </button>

        <div class="picks-track overflow-x-auto flex gap-3 snap-x snap-mandatory scroll-smooth px-4 pt-1 pb-2"
             data-picks-carousel-target="track">

          <% sc.nominees.each do |nom| %>
            <div class="flex-shrink-0 snap-center select-none flex flex-col items-center"
                 data-slide
                 data-nominee-id="<%= nom.id %>"
                 data-nominee-name="<%= nom.display_name %>">

              <div class="relative rounded-lg bg-oscar-surface transition-all duration-150 flex-shrink-0"
                   style="width: 120px; height: 180px; box-sizing: border-box; border: 2px solid transparent;"
                   data-poster-wrap>
                <div class="absolute inset-0 overflow-hidden rounded-lg">
                  <% if nom.poster_url.present? %>
                    <img src="<%= nom.poster_url %>"
                         alt="<%= nom.movie_name %>"
                         class="w-full h-full object-cover">
                  <% else %>
                    <div class="w-full h-full flex flex-col items-center justify-center gap-2 p-2">
                      <svg class="w-6 h-6 text-oscar-border" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M18 4H6C4.9 4 4 4.9 4 6v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H6V6h12v12zm-4.5-6L11 15.5 9 13l-3 4h12l-4.5-6z"/>
                      </svg>
                      <span class="text-[10px] text-oscar-muted text-center leading-tight"><%= nom.movie_name %></span>
                    </div>
                  <% end %>
                </div>

                <div class="pointer-events-none"
                     style="position: absolute; top: 6px; left: 6px; right: 6px; z-index: 1; display: flex; flex-wrap: wrap; gap: 4px;">
                  <% @pick_types.each do |pick_type| %>
                    <span data-pick-badge="<%= pick_type.id %>" hidden
                          class="text-[10px] font-black text-white px-1.5 py-0.5 rounded leading-none shadow-sm"
                          style="background-color: <%= pick_type.color %>;"
                          title="<%= pick_type.name %>"><%= pick_type.emoji %></span>
                  <% end %>
                </div>
              </div>

              <p class="text-[12px] text-oscar-text font-medium text-center whitespace-nowrap mt-2 mb-2">
                <%= nom.display_name %>
              </p>

              <div class="flex gap-1 w-full">
                <% @pick_types.each do |pick_type| %>
                  <button type="button"
                          data-action="click->picks-carousel#togglePick"
                          data-nominee-id="<%= nom.id %>"
                          data-pick-type-id="<%= pick_type.id %>"
                          data-pick-btn="<%= pick_type.id %>"
                          data-active="false"
                          title="<%= pick_type.name %>"
                          class="pick-type-btn flex-1 text-xs py-1.5 rounded-md border font-bold transition-colors leading-none min-w-[36px]"
                          style="--pick-color: <%= pick_type.color %>">
                    <%= pick_type.emoji %>
                  </button>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <button type="button"
                data-action="click->picks-carousel#next"
                class="absolute right-0 top-[72px] -translate-y-1/2 z-10 w-7 h-7 flex items-center justify-center rounded-full bg-white border border-oscar-border shadow text-oscar-muted hover:text-oscar-text hover:shadow-md transition-all text-lg leading-none select-none">
          &#8250;
        </button>
      </div>
    </div>
  <% end %>

<% end %>

<script>
(function () {
  function syncPosterRings() {
    document.querySelectorAll("[data-slide]").forEach((slide) => {
      const poster = slide.querySelector("[data-poster-wrap]")
      if (!poster) return

      const activeColors = []
      slide.querySelectorAll("[data-pick-btn][data-active='true']").forEach((btn) => {
        const color = btn.style.getPropertyValue("--pick-color")
        if (color) activeColors.push(color)
      })

      poster.style.outline = ""
      poster.style.outlineOffset = ""
      poster.style.boxShadow = ""

      if (activeColors.length === 0) {
        poster.style.borderColor = "transparent"
        return
      }

      poster.style.borderStyle = "solid"
      if (activeColors.length === 1) {
        poster.style.borderWidth = "2.5px"
        poster.style.borderColor = activeColors[0]
      } else {
        poster.style.borderWidth = "3px"
        poster.style.borderColor = "#f59e0b"
      }
    })
  }

  document.addEventListener("DOMContentLoaded", () => setTimeout(syncPosterRings, 0))
  window.addEventListener("picks-carousel:changed", syncPosterRings)
})()
</script>
